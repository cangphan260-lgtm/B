--==================================================
-- NOTIFICATION
--==================================================

local function notify(title, message)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = message,
			Duration = 5
		})
	end)
end

--==================================================
-- NAME DETECTOR
--==================================================

local function containsKeyword(name, keywords)
	name = string.lower(name)

	for _, keyword in ipairs(keywords) do
		if string.find(name, keyword, 1, true) then
			return true
		end
	end

	return false
end

--==================================================
-- AUTO HARVEST
--==================================================

local function tryHarvest()
	if not AutoHarvest then
		return
	end

	if os.clock() - lastHarvest < HARVEST_COOLDOWN then
		return
	end

	lastHarvest = os.clock()

	for _, object in ipairs(Workspace:GetDescendants()) do

		if object:IsA("ProximityPrompt") then

			local parentName = object.Parent and object.Parent.Name or ""

			if containsKeyword(object.Name, HarvestKeywords)
				or containsKeyword(parentName, HarvestKeywords) then

				if object.Enabled then
					pcall(function()
						fireproximityprompt(object)
					end)
				end
			end
		end
	end
end

--==================================================
-- LIGHTNING WARNING
--==================================================

local function lightningWarning(reason)
	if not ProtectionEnabled then
		return
	end

	if os.clock() - lastWarning < WARNING_COOLDOWN then
		return
	end

	lastWarning = os.clock()

	notify(
		"⚡ CẢNH BÁO SÉT!",
		"Sét chuẩn bị đánh!\n" .. reason
	)

	-- Thu hoạch ngay khi phát hiện dấu hiệu
	tryHarvest()
end

--==================================================
-- WORKSPACE DETECTOR
--==================================================

Workspace.DescendantAdded:Connect(function(object)

	if not ProtectionEnabled then
		return
	end

	if containsKeyword(object.Name, LightningKeywords) then
		lightningWarning(
			"Phát hiện: " .. object.Name
		)
	end

end)

--==================================================
-- LIGHTING DETECTOR
--==================================================

local oldBrightness = Lighting.Brightness
local oldAmbient = Lighting.Ambient
local oldOutdoor = Lighting.OutdoorAmbient

task.spawn(function()

	while task.wait(0.1) do

		if not ProtectionEnabled then
			continue
		end

		local brightnessChanged =
			math.abs(Lighting.Brightness - oldBrightness) > 0.35

		local ambientChanged =
			(Lighting.Ambient - oldAmbient).Magnitude > 0.15

		local outdoorChanged =
			(Lighting.OutdoorAmbient - oldOutdoor).Magnitude > 0.15

		if brightnessChanged
			or ambientChanged
			or outdoorChanged then

			lightningWarning(
				"Phát hiện thay đổi ánh sáng/thời tiết"
			)

			oldBrightness = Lighting.Brightness
			oldAmbient = Lighting.Ambient
			oldOutdoor = Lighting.OutdoorAmbient
		end
	end

end)

